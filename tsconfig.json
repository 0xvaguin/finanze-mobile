{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "jest",
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/data/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [],
  "extends": "expo/tsconfig.base"
}
