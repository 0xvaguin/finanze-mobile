{
  "expo": {
    "name": "Finanze",
    "slug": "finanze-mobile",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "finanze",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.finanze.mobile"
    },
    "android": {
      "package": "app.finanze.mobile",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F14"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Finanze usa o Face ID para desbloquear o app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}